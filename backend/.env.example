# ─── Local development defaults ─────────────────────────────────────────
# Copy this file to backend/.env (which is gitignored) and adjust as needed.
# The dev scripts (./dev.sh, .\dev.ps1) start a local VoidDB on http://localhost:7700
# with username=admin / password=admin, matching the values below.

# VoidDB (local docker container started by dev.sh / dev.ps1)
VOIDDB_URL=http://localhost:7700
VOIDDB_USERNAME=admin
VOIDDB_PASSWORD=admin
VOIDDB_TOKEN=

# Backend auth — dev secrets are fine locally. (JWT_SECRET must be ≥32 chars.)
JWT_SECRET=dev-secret-please-change-me-1234567890ab
BACKEND_SECRET=dev-backend-secret

# Optional: point SITE_URL at the prod frontend so YooKassa return URLs resolve.
# Not required to boot locally.
SITE_URL=http://localhost:3000
PORT=3001
NODE_ENV=development

# ─── VPN fallback (used when vpn_servers collection is empty) ──────────
# Guarantees that an active subscriber always sees a vlessLink/mtprotoLink
# in /user/profile, even if the VPN node hasn't (re)registered yet.
# Production box: s1.lowkey.su == lowkey.su == 193.41.5.130 (same host).
VPN_FALLBACK_HOST=s1.lowkey.su
VPN_FALLBACK_IP=193.41.5.130
VPN_FALLBACK_LOCATION=Russia · Moscow
VPN_DEFAULT_VLESS_PORT=2443
MTPROTO_FALLBACK_PORT=2444
# MTPROTO_FALLBACK_SECRET=ddXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX  # uncomment to enable MTProto link fallback
